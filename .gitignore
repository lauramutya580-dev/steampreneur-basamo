# ==========================================
# BSS - Bank Syariah Sekolah (BASAMO)
# ==========================================

# --- 1. File Rahasia & Kredensial (WAJIB DI-IGNORE) ---
# Memastikan tidak ada data sensitif yang ter-upload ke repositori
.env
.env.*
!.env.example
credentials.json
token.json
service-account.json
*.key
*.pem
secrets/

# --- 2. Google Apps Script & Clasp Specific ---
# File konfigurasi lokal CLASP dan backup
.clasp/
.claspignore
appsscript.json.bak
*.gs~

# --- 3. Sistem Operasi, Editor, & IDE ---
# Mencegah file sampah dari OS dan code editor masuk ke repo
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# --- 4. Log, Cache, & Build Lokal ---
# File sementara yang tidak perlu di-versioning
*.log
.cache/
test-results/

# ==========================================
