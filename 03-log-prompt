showLoading('btn-change-pin');
const user = allData.find(d => d.__backendId === currentUser.__backendId);
const result = await window.dataSdk.update({ ...user, pin: newPin });
hideLoading('btn-change-pin');
if (result.isOk) {
currentUser = { ...currentUser, pin: newPin };
showToast('PIN berhasil diubah', 'success');
['old-pin', 'new-pin'].forEach(id => { const el = document.getElementById(id); if (el) el.value = ''; });
