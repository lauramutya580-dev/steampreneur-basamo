};

const handleTransaction = async () => {
  // Validasi PIN Teller jika ada
  if (currentUser?.role === 'teller') {
    if (currentUser?.blocked) {
      showBlockedModal();
      return;
    }
    const pin = await showTellerPinModal();
    if (!pin) {
      showToast('Transaksi dibatalkan', 'error');
      return;
    }
    if (pin !== currentUser?.pin) {
      const result = await handleTellerPinError(currentUser.__backendId, currentUser?.pin_attempts);
      if (result?.blocked) {
        showBlockedModal();
        return;
      } else {
        const remaining = 3 - result.attempts;
        showPinErrorModal(remaining);
        return;
      }
    }
    await resetTellerPinAttempts(currentUser.__backendId);
  }

  const type = document.getElementById('trx-type')?.value;
  const account = document.getElementById('trx-account')?.value.trim();
  const amount = parseRupiah(document.getElementById('trx-amount')?.value);
  const desc = document.getElementById('trx-desc')?.value.trim();
  
  const nasabah = getUserByPhone(account);
  if (!nasabah || nasabah.status !== 'active') { 
    showToast('Nasabah tidak ditemukan', 'error'); 
    return; 
  }
  if (!amount || amount <= 0) { 
    showToast('Masukkan jumlah yang valid', 'error'); 
    return; 
  }
  if (type === 'tarik' && nasabah.balance < amount) { 
    showToast('Saldo tidak mencukupi', 'error'); 
    return; 
  }

  // 🔥 ANTI-DUPLIKASI: Generate unique transaction key
  const transactionKey = `trx_${account}_${amount}_${type}_${Date.now()}`;
  
  // Cek apakah transaksi sedang diproses
  const processingKey = sessionStorage.getItem('currentTransaction');
  if (processingKey) {
    showToast('Transaksi sebelumnya masih diproses...', 'warning');
    return;
  }
  
  // Simpan key transaksi saat ini
  sessionStorage.setItem('currentTransaction', transactionKey);
  
  showLoading('btn-trx');
  
  try {
    const newBalance = type === 'setor' ? nasabah.balance + amount : nasabah.balance - amount;
    const now = new Date().toISOString();
    
    // 🔥 LANGKAH 1: Buat transaksi
    const transactionData = {
      type: 'transaction', 
      transaction_type: type, 
      amount: amount,
      from_account: type === 'tarik' ? account : '-', 
      to_account: type === 'setor' ? account : '-',
      from_name: type === 'tarik' ? nasabah.name : currentUser?.name,
      to_name: type === 'setor' ? nasabah.name : currentUser?.name,
      description: desc || `${type === 'setor' ? 'Setor' : 'Tarik'} Tunai`,
      teller_name: currentUser?.name, 
      created_at: now,
      __tempKey: transactionKey // Untuk tracking
    };
    
    const resultTrx = await window.dataSdk.create(transactionData);
    
    if (!resultTrx.isOk) {
      throw new Error('Gagal membuat transaksi: ' + (resultTrx.error || 'Unknown error'));
    }
    
    // 🔥 LANGKAH 2: Update saldo
    const resultUpdate = await window.dataSdk.update({ ...nasabah, balance: newBalance });
    
    if (!resultUpdate.isOk) {
      // 🔥 ROLLBACK: Hapus transaksi jika update saldo gagal
      const transactions = getTransactions();
      const failedTransaction = transactions.find(t => 
        t.__tempKey === transactionKey || 
        (t.transaction_type === type && 
         t.amount === amount && 
         t.to_account === (type === 'setor' ? account : '-') &&
         new Date(t.created_at) > new Date(Date.now() - 10000))
      );
      
      if (failedTransaction) {
        await window.dataSdk.delete(failedTransaction);
      }
      
      throw new Error('Update saldo gagal: ' + (resultUpdate.error || 'Unknown error'));
    }
    
    // ✅ SUKSES
    hideLoading('btn-trx');
    sessionStorage.removeItem('currentTransaction');
    
    const nowDate = new Date();
    showSuccessModal('Transaksi Berhasil!', `
      <div class="space-y-2">
        <p><span class="text-gray-500">Tanggal:</span> ${nowDate.toLocaleDateString('id-ID')}</p>
        <p><span class="text-gray-500">Jam:</span> ${nowDate.toLocaleTimeString('id-ID')}</p>
        <p><span class="text-gray-500">Jenis:</span> <strong>${type === 'setor' ? 'Setor Tunai' : 'Tarik Tunai'}</strong></p>
        <p><span class="text-gray-500">Jumlah:</span> <strong class="text-amber-600">${formatRupiah(amount)}</strong></p>
        <p><span class="text-gray-500">No. Rekening:</span> ${account}</p>
        <p><span class="text-gray-500">Nama:</span> ${nasabah.name}</p>
        <p><span class="text-gray-500">Keterangan:</span> ${desc || '-'}</p>
      </div>`);
    
    // Reset form
    ['trx-account', 'trx-amount', 'trx-desc', 'trx-nasabah-info'].forEach(id => {
      const el = document.getElementById(id);
      if (el) {
        if (id === 'trx-nasabah-info') el.innerHTML = '';
        else el.value = '';
      }
    });
    
  } catch (error) {
    console.error('Transaction error:', error);
    hideLoading('btn-trx');
    sessionStorage.removeItem('currentTransaction');
    showToast(error.message || 'Gagal memproses transaksi', 'error');
  }
};

