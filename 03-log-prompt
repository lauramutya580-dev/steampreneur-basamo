bg_color: '#f8f9fa'
};
let config = { ...defaultConfig };
let allData = [];
let currentUser = null;
let currentView = 'login';
let currentSubView = 'dashboard';
let _lastDataHash = '';
let _pendingUpdates = [];
let _updateTimer = null;

// ==================== PERFORMANCE UTILITIES ====================
const debounce = (func, wait) => {
let timeout;
return function executedFunction(...args) {
const later = () => { clearTimeout(timeout); func(...args); };
clearTimeout(timeout);
timeout = setTimeout(later, wait);
};
};
const throttle = (func, limit) => {
let inThrottle;
return function(...args) {
if (!inThrottle) {
func.apply(this, args);
inThrottle = true;
setTimeout(() => inThrottle = false, limit);
}
};
};
const generateId = () => Math.random().toString(36).substr(2, 9) + Date.now().toString(36);

// ==================== DATA SDK ====================
window.dataSdk = {
_requestQueue: [],
_processing: false,
_processQueue: async function() {
if (this._processing || this._requestQueue.length === 0) return;
this._processing = true;
while (this._requestQueue.length > 0) {
const { resolve, reject, fn } = this._requestQueue.shift();
try {
const result = await fn();
resolve(result);
} catch (error) {
reject(error);
}
await new Promise(r => setTimeout(r, 50));
}
this._processing = false;
},
_queueRequest: function(fn) {
return new Promise((resolve, reject) => {
this._requestQueue.push({ resolve, reject, fn });
this._processQueue();
});
},
init: async (handler) => {
window._dataHandler = handler;
return new Promise((resolve) => {
const fetchData = () => {
return new Promise((res) => {
if (typeof google !== 'undefined' && google.script && google.script.run) {
google.script.run.withSuccessHandler(data => {
_lastDataHash = JSON.stringify(data);
handler.onDataChanged(data);
res({ isOk: true });
}).withFailureHandler(err => {
console.error('Init error:', err);
res({ isOk: false, error: err.message });
}).getAllData();
} else {
console.warn("Mode Preview: Menggunakan LocalStorage");
const localData = JSON.parse(localStorage.getItem('bss_data') || '[]');
_lastDataHash = JSON.stringify(localData);
handler.onDataChanged(localData);
res({ isOk: true });
}
});
};
let attempts = 0;
const tryInit = async () => {
const result = await fetchData();
if (result.isOk || attempts >= 3) {
resolve(result);
} else {
attempts++;
setTimeout(tryInit, Math.pow(2, attempts) * 500);
}
};
tryInit();
});
},
create: async (data) => {
return window.dataSdk._queueRequest(async () => {
return new Promise((resolve) => {
const doCreate = () => {
if (typeof google !== 'undefined' && google.script && google.script.run) {
google.script.run.withSuccessHandler(res => {
if(res.status) {
_lastDataHash = JSON.stringify(res.allData);
window._dataHandler.onDataChanged(res.allData);
}
resolve({ isOk: res.status, error: res.error });
}).withFailureHandler(err => {
console.error('Create failed:', err);
resolve({ isOk: false, error: err.message });
}).handleCreate(data);
} else {
data.__backendId = generateId();
const localData = JSON.parse(localStorage.getItem('bss_data') || '[]');
localData.push(data);
localStorage.setItem('bss_data', JSON.stringify(localData));
_lastDataHash = JSON.stringify(localData);
window._dataHandler.onDataChanged(localData);
resolve({ isOk: true });
}
};
doCreate();
});
});
},
createBatch: async (dataArray) => {
if (!dataArray || dataArray.length === 0) return { isOk: true };
return window.dataSdk._queueRequest(async () => {
return new Promise((resolve) => {
if (typeof google !== 'undefined' && google.script && google.script.run) {
google.script.run.withSuccessHandler(res => {
if(res.status) {
_lastDataHash = JSON.stringify(res.allData);
window._dataHandler.onDataChanged(res.allData);
}
resolve({ isOk: res.status, error: res.error });
}).withFailureHandler(err => {
console.error('CreateBatch failed:', err);
resolve({ isOk: false, error: err.message });
}).handleCreateBatch(dataArray);
} else {
const localData = JSON.parse(localStorage.getItem('bss_data') || '[]');
dataArray.forEach(data => {
data.__backendId = generateId();
localData.push(data);
});
localStorage.setItem('bss_data', JSON.stringify(localData));
_lastDataHash = JSON.stringify(localData);
window._dataHandler.onDataChanged(localData);
resolve({ isOk: true });
}
});
});
},
update: async (data) => {
return window.dataSdk._queueRequest(async () => {
return new Promise((resolve) => {
if (typeof google !== 'undefined' && google.script && google.script.run) {
google.script.run.withSuccessHandler(res => {
if(res.status) {
_lastDataHash = JSON.stringify(res.allData);
window._dataHandler.onDataChanged(res.allData);
}
resolve({ isOk: res.status, error: res.error });
}).withFailureHandler(err => {
console.error('Update failed:', err);
resolve({ isOk: false, error: err.message });
}).handleUpdate(data);
} else {
const localData = JSON.parse(localStorage.getItem('bss_data') || '[]');
const index = localData.findIndex(d => d.__backendId === data.__backendId);
if (index !== -1) {
localData[index] = data;
localStorage.setItem('bss_data', JSON.stringify(localData));
_lastDataHash = JSON.stringify(localData);
window._dataHandler.onDataChanged(localData);
resolve({ isOk: true });
} else {
resolve({ isOk: false, error: 'Not found' });
}
}
});
});
},
delete: async (data) => {
return window.dataSdk._queueRequest(async () => {
return new Promise((resolve) => {
if (typeof google !== 'undefined' && google.script && google.script.run) {
google.script.run.withSuccessHandler(res => {
if(res.status) {
_lastDataHash = JSON.stringify(res.allData);
window._dataHandler.onDataChanged(res.allData);
}
resolve({ isOk: res.status, error: res.error });
}).withFailureHandler(err => {
console.error('Delete failed:', err);
resolve({ isOk: false, error: err.message });
}).handleDelete(data);
} else {
let localData = JSON.parse(localStorage.getItem('bss_data') || '[]');
localData = localData.filter(d => d.__backendId !== data.__backendId);
localStorage.setItem('bss_data', JSON.stringify(localData));
_lastDataHash = JSON.stringify(localData);
window._dataHandler.onDataChanged(localData);
resolve({ isOk: true });
}
});
});
},
atomicTransfer: async (transferData) => {
return window.dataSdk._queueRequest(async () => {
return new Promise((resolve) => {
if (typeof google !== 'undefined' && google.script && google.script.run) {
google.script.run.withSuccessHandler(res => {
if(res.status) {
_lastDataHash = JSON.stringify(res.allData);
window._dataHandler.onDataChanged(res.allData);
}
resolve({ isOk: res.status, error: res.error, allData: res.allData });
}).withFailureHandler(err => {
console.error('Atomic transfer failed:', err);
resolve({ isOk: false, error: err.message });
}).handleAtomicTransfer(transferData);
} else {
console.warn("Atomic transfer: Mode preview (tanpa lock server)");
const { fromAccount, toAccount, amount, description, senderName, targetName, timestamp } = transferData;
const localData = JSON.parse(localStorage.getItem('bss_data') || '[]');
const sender = localData.find(u => u.phone === fromAccount && u.role === 'nasabah');
const target = localData.find(u => u.phone === toAccount && u.role === 'nasabah');
if (!sender || !target) {
resolve({ isOk: false, error: 'Salah satu rekening tidak ditemukan (mode preview)' });
return;
}
if (sender.balance < amount) {
resolve({ isOk: false, error: 'Saldo tidak mencukupi (mode preview)' });
return;
}
sender.balance -= amount;
target.balance += amount;
localData.push({
type: 'transaction', __backendId: generateId(), __version: 1,
__timestamp: timestamp || new Date().toISOString(),
transaction_type: 'transfer', amount, from_account: fromAccount, to_account: toAccount,
from_name: senderName || sender.name, to_name: targetName || target.name,
description: description || 'Transfer', created_at: timestamp || new Date().toISOString()
});
localStorage.setItem('bss_data', JSON.stringify(localData));
_lastDataHash = JSON.stringify(localData);
window._dataHandler.onDataChanged(localData);
resolve({ isOk: true });
}
});
});
}
};

