<td class="p-2 border">${formatDateTime(t.created_at)}</td>
<td class="p-2 border"><span class="px-2 py-1 rounded-full text-xs ${t.transaction_type === 'setor' ? 'bg-green-100 text-green-600' : t.transaction_type === 'tarik' ? 'bg-red-100 text-red-600' : 'bg-blue-100 text-blue-600'}">${t.transaction_type}</span></td>
<td class="p-2 border">${t.from_name || '-'}<br><span class="text-gray-400 text-xs">${t.from_account || ''}</span></td>
<td class="p-2 border">${t.to_name || '-'}<br><span class="text-gray-400 text-xs">${t.to_account || ''}</span></td>
<td class="p-2 border text-right font-medium">${formatRupiah(t.amount)}</td>
<td class="p-2 border">${t.description || '-'}</td>
</tr>`).join('') || '<tr><td colspan="7" class="p-4 text-center text-gray-400">Tidak ada transaksi pada periode ini</td></tr>'}
</tbody>
</table>
</div>
<div class="mt-6 bg-gray-50 rounded-xl p-4">
<h4 class="font-bold mb-3">Ringkasan:</h4>
<div class="grid grid-cols-3 gap-4 text-sm">
<div><p class="text-gray-500">Total Setor Tunai:</p><p class="font-bold text-green-600 text-lg">${formatRupiah(totalSetor)}</p></div>
<div><p class="text-gray-500">Total Tarik Tunai:</p><p class="font-bold text-red-600 text-lg">${formatRupiah(totalTarik)}</p></div>
<div><p class="text-gray-500">Total Transfer:</p><p class="font-bold text-blue-600 text-lg">${formatRupiah(totalTransfer)}</p></div>
</div>
</div>
<div class="mt-12 flex justify-end">
<div class="text-center w-48">
<p class="text-sm text-gray-700 mb-16">Kerinci, ${new Date().toLocaleDateString('id-ID')}<br>Petugas Pencetak,</p>
<p class="font-bold text-gray-800 underline">${currentUser?.name || 'Petugas'}</p>
<p class="text-xs text-gray-500 capitalize">${currentUser?.role || 'Staff'}</p>
</div>
</div>
<div class="mt-6 flex justify-end gap-3 print-hide">
<button onclick="closeModal()" class="px-6 py-2 bg-gray-100 text-gray-700 rounded-xl hover:bg-gray-200">Tutup</button>
<button onclick="window.print()" class="px-6 py-2 bg-purple-500 text-white rounded-xl hover:bg-purple-600">Cetak</button>
</div>
</div>`;
showModal(content, '4xl');
};

// ==================== DATA HANDLER & REALTIME SYNC ====================
const softUpdateUI = () => {
if (currentUser?.role === 'nasabah') {
const dashBalance = document.getElementById('nasabah-dashboard-balance');
if (dashBalance) dashBalance.innerText = formatRupiah(currentUser.balance);
const tfBalance = document.getElementById('nasabah-transfer-balance');
if (tfBalance) tfBalance.innerText = formatRupiah(currentUser.balance);
const unreadCount = allData.filter(d => d.type === 'notification' && d.to_account === currentUser.phone && !d.read).length;
const badge = document.getElementById('notif-badge');
if (badge) {
badge.innerText = unreadCount;
badge.classList.toggle('hidden', unreadCount === 0);
badge.classList.toggle('flex', unreadCount > 0);
}
} else {
const pendingCount = getPendingNasabah().length;
const staffBadge = document.getElementById('staff-notif-badge');
if (staffBadge) {
staffBadge.innerText = pendingCount;
staffBadge.classList.toggle('hidden', pendingCount === 0);
staffBadge.classList.toggle('flex', pendingCount > 0);
}
}
if (document.getElementById('modal-overlay')) return;
const activeEl = document.activeElement;
const isTyping = activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA');
if (isTyping) return;
if (currentSubView === 'dashboard') {
renderContent();
} else if (currentSubView === 'history') {
filterHistory();
} else if (currentSubView === 'nasabah') {
filterNasabah();
} else if (['admin', 'teller', 'cs'].includes(currentSubView)) {
renderContent();
}
};
const dataHandler = {
onDataChanged(data) {
allData = data;
invalidateDataCache();
if (currentUser) {
const updatedUser = allData.find(d => d.__backendId === currentUser.__backendId);
if (updatedUser) {
currentUser = updatedUser;
} else {
logout();
return;
}
}
if (currentView === 'dashboard') {
softUpdateUI();
}
}
};

// ==================== POLLING & INIT ====================
const startPolling = () => {
let pollingInterval = null;
const poll = () => {
if (!currentUser) return;
const doPoll = () => {
if (typeof google !== 'undefined' && google.script && google.script.run) {
google.script.run.withSuccessHandler(data => {
const newHash = JSON.stringify(data);
if (_lastDataHash !== newHash) {
_lastDataHash = newHash;
dataHandler.onDataChanged(data);
}
}).withFailureHandler(() => {}).getAllData();
} else {
const localData = JSON.parse(localStorage.getItem('bss_data') || '[]');
const newHash = JSON.stringify(localData);
if (_lastDataHash !== newHash) {
_lastDataHash = newHash;
dataHandler.onDataChanged(localData);
}
}
};
doPoll();
};
poll();
pollingInterval = setInterval(() => {
if (!document.hidden) poll();
}, 5000);
document.addEventListener('visibilitychange', () => {
if (document.hidden) {
if (pollingInterval) clearInterval(pollingInterval);
} else {
poll();
pollingInterval = setInterval(() => { if (!document.hidden) poll(); }, 5000);
}
});
};
const init = async () => {
    if (window.dataSdk) {
        const result = await window.dataSdk.init(dataHandler);
        if (!result.isOk) {
            console.error('Failed to initialize Data SDK:', result.error);
            document.getElementById('app').innerHTML = `
            <div class="text-center p-8">
                <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-red-100 flex items-center justify-center">
                    <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                </div>
                <h3 class="text-xl font-bold text-gray-800 mb-2">Koneksi Gagal</h3>
                <p class="text-gray-600 mb-4">Gagal memuat database dari server.</p>
                <button onclick="location.reload()" class="px-6 py-2 bg-amber-500 text-white rounded-xl hover:bg-amber-600">Muat Ulang</button>
            </div>`;
        } else {
            // 🔥 MODIFIKASI: Baca parameter URL (?page=nasabah / ?page=admin)
            if (typeof google !== 'undefined' && google.script && google.script.url) {
                google.script.url.getLocation(function(location) {
                    window.loginMode = location.parameter.page || 'all';
                    renderLogin();
                    startPolling();
                });
            } else {
                // Fallback untuk mode preview / lokal
                const urlParams = new URLSearchParams(window.top ? window.top.location.search : window.location.search);
                window.loginMode = urlParams.get('page') || 'all';
                renderLogin();
                startPolling();
            }
        }
    }
};

// ==================== TELLER PIN MODAL ====================
const showTellerPinModal = () => {
return new Promise((resolve) => {
const content = `
<div class="p-6 text-center">
<div class="w-16 h-16 mx-auto mb-4 rounded-full bg-amber-100 flex items-center justify-center">${getIcon('key')}</div>
<h3 class="text-xl font-bold text-gray-800 mb-2">Masukkan PIN Teller</h3>
<p class="text-gray-500 mb-6">Masukkan PIN 6 digit untuk konfirmasi transaksi tunai</p>
<input type="password" id="teller-pin-input" maxlength="6" class="w-full px-4 py-3 border border-gray-200 rounded-xl text-center text-2xl tracking-widest focus:ring-2 focus:ring-amber-500" placeholder="• • • • • •" autocomplete="off">
<div class="flex gap-3 mt-6">
<button onclick="closeModal(); if(window._tellerPinResolve) { window._tellerPinResolve(null); window._tellerPinResolve = null; }" class="flex-1 px-4 py-3 border border-gray-200 rounded-xl hover:bg-gray-50">Batal</button>
<button id="btn-confirm-teller-pin" onclick="confirmTellerPin()" class="flex-1 px-4 py-3 bg-amber-500 text-white rounded-xl hover:bg-amber-600">Konfirmasi</button>
</div>
</div>`;
showModal(content, 'sm');
window._tellerPinResolve = resolve;
setTimeout(() => {
const pinInput = document.getElementById('teller-pin-input');
if (pinInput) {
pinInput.focus();
pinInput.addEventListener('keypress', (e) => {
if (e.key === 'Enter') confirmTellerPin();
});
}
}, 100);
});
};
const confirmTellerPin = () => {
const pin = document.getElementById('teller-pin-input')?.value;
if (window._tellerPinResolve) {
window._tellerPinResolve(pin);
window._tellerPinResolve = null;
}
closeModal();
};

// ==================== INIT ====================
if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', init);
} else {
init();
}
</script>
</body>
</html>
