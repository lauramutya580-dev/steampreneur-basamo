<script>
// ==================== CONFIG & STATE (Optimized) ====================
const defaultConfig = {
app_title: 'Bank Syariah Sekolah',
school_name: 'SMKN 2 KERINCI',
primary_color: '#1a1a2e',
secondary_color: '#D4AF37',
accent_color: '#16213e',
