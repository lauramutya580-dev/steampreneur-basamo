            }
            resolve({ isOk: true, director: res.director });
          } else {
            resolve({ isOk: false, error: res.error });
          }
        })
        .withFailureHandler(err => {
          resolve({ isOk: false, error: err.message });
        })
        .handleDirectorLogin(username, password);
