const handleTellerPinError = async (tellerId, currentAttempts) => {
const newAttempts = (currentAttempts || 0) + 1;
const teller = allData.find(d => d.__backendId === tellerId);
if (!teller) return;
const updatedTeller = {
...teller,
pin_attempts: newAttempts,
blocked: newAttempts >= 3
};
await window.dataSdk.update(updatedTeller);
if (currentUser?.__backendId === tellerId) {
currentUser = updatedTeller;
}
return { attempts: newAttempts, blocked: newAttempts >= 3 };
};
const resetTellerPinAttempts = async (tellerId) => {
const teller = allData.find(d => d.__backendId === tellerId);
if (!teller || !teller.pin_attempts) return;
if (teller.pin_attempts > 0) {
await window.dataSdk.update({
...teller,
pin_attempts: 0
});
}
};

