// ==================== AUTH HANDLERS ====================
const handleLogin = async () => {
    const username = document.getElementById('login-username')?.value.trim();
    const password = document.getElementById('login-password')?.value;
    const mode = window.loginMode || 'all'; // Ambil mode dari parameter URL (?page=nasabah / ?page=admin)

    if (!username || !password) {
        showToast('Mohon isi username dan password', 'error');
        return;
    }

    showLoading('btn-login');

    // Cek direktur lewat backend, password tidak lagi tertulis di frontend
    const directorCheck = await checkDirectorLogin(username, password);
    if (directorCheck.isOk && directorCheck.director) {
        // 🔥 BLOKIR DIREKTUR JIKA MEMAKSA LOGIN DI URL NASABAH
        if (mode === 'nasabah') {
            hideLoading('btn-login');
            showToast('Akses ditolak. Portal ini khusus untuk Nasabah.', 'error');
            return;
        }
        currentUser = directorCheck.director;
        currentView = 'dashboard';
        currentSubView = 'dashboard';
        hideLoading('btn-login');
        renderDashboard();
        return;
    }

    const user = getUsers().find(u =>
        (u.username === username || u.phone === username) && u.password === password
    );
    hideLoading('btn-login');

    if (!user) {
        showToast('Username atau password salah', 'error');
        return;
    }

    // 🔥 VALIDASI ROLE BERDASARKAN MODE URL (PENTING!)
    if (mode === 'nasabah' && user.role !== 'nasabah') {
        showToast('Akses ditolak. Akun Staff/Admin tidak bisa login di Portal Nasabah.', 'error');
        return;
    }
    
    if ((mode === 'admin' || mode === 'staff') && user.role === 'nasabah') {
        showToast('Akses ditolak. Akun Nasabah tidak bisa login di Portal Admin/Staff.', 'error');
        return;
    }

    if (user.blocked) {
        showBlockedModal();
        return;
    }

    if (user.status === 'pending') {
        showToast('Akun Anda belum diaktifkan. Mohon tunggu konfirmasi.', 'warning');
        return;
    }

    if (user.status === 'inactive') {
        showToast('Akun Anda telah dinonaktifkan. Hubungi admin.', 'error');
        return;
    }

    currentUser = user;
    currentView = 'dashboard';
    currentSubView = 'dashboard';
    renderDashboard();
};
const handleRegister = async () => {
const name = document.getElementById('reg-name')?.value.trim();
const phone = document.getElementById('reg-phone')?.value.trim();
const category = document.getElementById('reg-category')?.value;
const kelas = document.getElementById('reg-kelas')?.value.trim() || '';
const password = document.getElementById('reg-password')?.value;
const pin = document.getElementById('reg-pin')?.value;
if (!name || !phone || !password || !pin) { showToast('Mohon lengkapi semua data', 'error'); return; }
if (category === 'pelajar' && !kelas) { showToast('Mohon isi kelas untuk pelajar', 'error'); return; }
if (!/^08\d{8,12}$/.test(phone)) { showToast('Format nomor HP tidak valid', 'error'); return; }
if (!/^\d{6}$/.test(pin)) { showToast('PIN harus 6 digit angka', 'error'); return; }
if (getUserByPhone(phone)) { showToast('Nomor HP sudah terdaftar', 'error'); return; }
showLoading('btn-register');
const result = await window.dataSdk.create({
type: 'user', username: phone, password: password, pin: pin, name: name, phone: phone,
role: 'nasabah', category: category, kelas: category === 'pelajar' ? kelas : '',
balance: 0, status: 'pending', pin_attempts: 0, blocked: false, created_at: new Date().toISOString()
});
hideLoading('btn-register');
if (result.isOk) {
showSuccessModal('Pendaftaran Berhasil!', `
<div class="space-y-2">
<p><span class="text-gray-500">Nama:</span> <strong>${name}</strong></p>
<p><span class="text-gray-500">No. Rekening:</span> <strong>${phone}</strong></p>
<p><span class="text-gray-500">Kategori:</span> <strong>${category === 'pelajar' ? 'Pelajar' : 'Umum'}</strong></p>
${kelas ? `<p><span class="text-gray-500">Kelas:</span> <strong>${kelas}</strong></p>` : ''}
<p class="text-amber-600 mt-4 text-sm">Akun Anda akan aktif setelah dikonfirmasi oleh Admin/CS.</p>
</div>`);
setTimeout(() => { closeModal(); renderLogin(); }, 3000);
} else {
showToast(result.error || 'Gagal mendaftar. Coba lagi.', 'error');
}
};
