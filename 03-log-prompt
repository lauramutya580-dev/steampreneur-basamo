showModal(content, 'sm');
setTimeout(() => {
const pinInput = document.getElementById('pin-input');
if (pinInput) {
pinInput.focus();
pinInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') handleTransfer(); });
}
}, 100);
};
const handleTransfer = async () => {
const pin = document.getElementById('pin-input')?.value;
const toAccount = document.getElementById('tf-to')?.value.trim();
const amount = parseRupiah(document.getElementById('tf-amount')?.value);
const desc = document.getElementById('tf-desc')?.value.trim();
if (pin !== currentUser?.pin) {
let user = allData.find(d => d.__backendId === currentUser.__backendId);
const attempts = (user?.pin_attempts || 0) + 1;
await window.dataSdk.update({ ...user, pin_attempts: attempts, blocked: attempts >= 3 });
closeModal();
if (attempts >= 3) {
showBlockedModal();
} else {
showPinErrorModal(3 - attempts);
}
return;
}
if (!toAccount || toAccount === currentUser?.phone) {
showToast('Rekening tujuan tidak valid', 'error'); return;
}
const target = getUserByPhone(toAccount);
if (!target || target.status !== 'active' || target.role !== 'nasabah') {
showToast('Rekening tujuan tidak valid', 'error'); return;
}
if (!amount || amount <= 0 || amount > currentUser?.balance) {
showToast('Jumlah tidak valid atau saldo tidak mencukupi', 'error'); return;
}
const settings = getSettings();
const maxTransfer = currentUser?.category === 'pelajar' ? (settings?.max_transfer_pelajar || 500000) : (settings?.max_transfer_umum || 2000000);
const today = new Date().toDateString();
const todayTransfers = getTransactions().filter(t =>
t.transaction_type === 'transfer' && t.from_account === currentUser?.phone && new Date(t.created_at).toDateString() === today
).reduce((sum, t) => sum + t.amount, 0);
if (todayTransfers + amount > maxTransfer) {
showToast(`Melebihi batas transfer harian (${formatRupiah(maxTransfer)})`, 'error'); return;
}
showLoading('btn-confirm-pin');
try {
const result = await window.dataSdk.atomicTransfer({
fromAccount: currentUser.phone, toAccount: toAccount, amount: amount,
description: desc || 'Transfer', senderName: currentUser.name, targetName: target.name,
timestamp: new Date().toISOString()
});
hideLoading('btn-confirm-pin');
closeModal();
if (result.isOk) {
const sender = allData.find(d => d.__backendId === currentUser.__backendId);
if (sender && sender.pin_attempts > 0) {
await window.dataSdk.update({ ...sender, pin_attempts: 0 });
}
const now = new Date();
showSuccessModal('Transfer Berhasil!', `
<div class="space-y-2">
<p><span class="text-gray-500">Tanggal:</span> ${now.toLocaleDateString('id-ID')}</p>
<p><span class="text-gray-500">Jam:</span> ${now.toLocaleTimeString('id-ID')}</p>
<p><span class="text-gray-500">Jumlah:</span> <strong class="text-amber-600">${formatRupiah(amount)}</strong></p>
<p><span class="text-gray-500">Sumber Dana:</span> ${currentUser.name} (${currentUser.phone})</p>
<p><span class="text-gray-500">Tujuan:</span> ${target.name} (${toAccount})</p>
<p><span class="text-gray-500">Keterangan:</span> ${desc || '-'}</p>
</div>`);
['tf-to', 'tf-amount', 'tf-desc', 'tf-target-info'].forEach(id => {
const el = document.getElementById(id);
if (el) { if (id === 'tf-target-info') el.innerHTML = ''; else el.value = ''; }
});
} else {
showToast(result.error || 'Gagal melakukan transfer', 'error');
}
} catch (error) {
hideLoading('btn-confirm-pin');
closeModal();
console.error('Transfer error:', error);
showToast('Terjadi kesalahan sistem. Silakan coba lagi.', 'error');
}
};

